NODE_ENV=development
PORT=8787

# Base Sepolia
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
BASE_EXPLORER_URL=https://sepolia.basescan.org

# Wallet used by API + TruthStake.submitClaim (must be ERC-8004 agent wallet for your agentId)
PRIVATE_KEY=

# Circle test USDC on Base Sepolia (from VeriBond Deploy.s.sol)
VERIBOND_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# After `forge script ... Deploy.s.sol` (see docs/DEPLOY_BASE_SEPOLIA.md)
VERIBOND_STAKING_ADDRESS=
VERIBOND_OWNER_BADGE_ADDRESS=
VERIBOND_MOCK_RESOLVER_ADDRESS=

# Optional / future
VERIBOND_REPUTATION_ADDRESS=
VERIBOND_BONDING_ADDRESS=

EXECUTION_MAX_NOTIONAL_USDC=10

# Execution-only demos (VeriBond trust is always on-chain in this repo)
SIMULATION_MODE=false

# LLM / privacy
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VENICE_API_KEY=

# Dashboard → API (local dev)
# NEXT_PUBLIC_PREDY_API=http://localhost:8787
# NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
