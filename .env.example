NODE_ENV=development
PORT=8787

# Base Sepolia
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
BASE_EXPLORER_URL=https://sepolia.basescan.org

# Swarm wallet — MUST equal identityRegistry.getAgentWallet(1..4) for each Predy agent id (see /api/predy/status).
# Locked layout: DataAgent=1, ConsensusAgent=2 (staking), PrivacyAgent=3, ExecutorAgent=4 — all same wallet.
PRIVATE_KEY=

# Expected shared control wallet (checksummed); must match PRIVATE_KEY address for staking to succeed.
PREDY_SWARM_SINGLE_WALLET=0x569CD75b6116b7C71D19C715EaAC157749Ccd0F8

# Single team registration (no new participant IDs inside Predy).
PREDY_TEAM_ID=1027239e8acf49eca9699d63b29879d9
# PREDY_TEAM_MEMBERS_LABEL=2 (Harsh + Predy)

# Circle test USDC on Base Sepolia (from VeriBond Deploy.s.sol)
VERIBOND_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# After `forge script ... Deploy.s.sol` (see docs/DEPLOY_BASE_SEPOLIA.md)
VERIBOND_STAKING_ADDRESS=
VERIBOND_OWNER_BADGE_ADDRESS=
VERIBOND_MOCK_RESOLVER_ADDRESS=

# MockResolver owner key — TruthStake.resolve calls resolver; for MockResolver, set outcome before resolve (prediction loop).
# Must be the address that deployed / owns MockResolver (see docs/DEPLOY_BASE_SEPOLIA.md).
MOCK_RESOLVER_ADMIN_PRIVATE_KEY=

# SQLite: users + swarms keyed by wallet (default ./data/predy.db)
# PREDY_DB_PATH=

# ERC-8004 Identity Registry (agent NFTs). Dashboard onboarding mints 5 tokens here.
# IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# Optional / future
VERIBOND_REPUTATION_ADDRESS=
VERIBOND_BONDING_ADDRESS=

EXECUTION_MAX_NOTIONAL_USDC=10

# Execution-only demos (VeriBond trust is always on-chain in this repo)
SIMULATION_MODE=false

# LLM / privacy (DataAgent sentiment + Consensus market use OpenAI; PrivacyAgent uses Venice)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VENICE_API_KEY=
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=llama-3.3-70b

# Supervised mode: when public confidence < 55%, still auto-execute this % of cycles (default 95).
AUTONOMY_AUTO_APPROVE_PERCENT=95

# Dashboard → API (local dev)
# NEXT_PUBLIC_PREDY_API=http://localhost:8787
# NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
